{
	"schemaVersion": 1,
	"id": "tater",
	"version": "${version}",
	"name": "Tater",
	"description": "Adds an (un)friendly Tater into your world :>",
	"authors": [
		"Tenneb22"
	],
	"contact": {
		"sources": "https://github.com/Tenneb22/Tater"
	},
	"license": "Apache-2.0",
	"icon": "assets/tater/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "io.github.tenneb22.tater.TaterMod"
		],
		"client": [
			"io.github.tenneb22.tater.client.TaterClient"
		],
		"fabric-datagen": [
			"io.github.tenneb22.tater.TaterDataGenerator"
		]
	},
	"mixins": [
